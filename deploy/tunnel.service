[Unit]
# Outbound tunnel: publishes 127.0.0.1:3124 on a public HTTPS hostname without
# any inbound port. Used because this host's provider filters inbound 80/443
# upstream, so ACME (both http-01 and tls-alpn-01) can never complete — see the
# self-hosting notes in README.md.
#
# This is the ACCOUNT-LESS "quick tunnel": the hostname is assigned by Cloudflare
# and CHANGES ON EVERY RESTART, with no uptime guarantee. Read the current one with:
#     grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' ~/housewarden/.data/tunnel.log | tail -1
# For a stable hostname, create a named tunnel against a domain you control and
# replace ExecStart with:  cloudflared tunnel run <name>
Description=Cloudflare tunnel publishing Housewarden (127.0.0.1:3124)
After=network-online.target housewarden.service
Wants=housewarden.service

[Service]
ExecStart=/home/abidali/.local/bin/cloudflared tunnel --url http://127.0.0.1:3124 --no-autoupdate --logfile /home/abidali/housewarden/.data/tunnel.log
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
