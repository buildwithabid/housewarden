# Housewarden — environment variables. Copy to .env.local (git-ignored).
# `npm run dev` creates .env.local with a random token and admin secret if it
# is missing, so for local use you normally never edit this by hand.

# --- Storage -----------------------------------------------------------------
# pglite (default): embedded Postgres, data in HOUSEWARDEN_DATA_DIR. Zero setup.
# pg: use DATABASE_URL (set HOUSEWARDEN_DB=pg or leave it unset with DATABASE_URL set).
HOUSEWARDEN_DB=pglite
HOUSEWARDEN_DATA_DIR=.data/pglite
# DATABASE_URL=postgres://user:pass@host:5432/housewarden?sslmode=require
# HOUSEWARDEN_PG_SSL=auto            # auto | require | disable | no-verify

# --- Secrets (never commit real values) ---------------------------------------
# Bearer token every MCP client must send: Authorization: Bearer <token>. >= 16 chars.
HOUSEWARDEN_TOKEN=hw_replace-me-with-a-long-random-value
# Console login secret for /login. >= 8 chars.
HOUSEWARDEN_ADMIN_SECRET=replace-me-too

# --- Guard -------------------------------------------------------------------
# Browser origins allowed to call /api/mcp (comma-separated full origins).
# Non-browser clients send no Origin header and are always allowed.
HOUSEWARDEN_ALLOWED_ORIGINS=
# How long a pending action waits for approval (seconds).
HOUSEWARDEN_CONFIRM_TTL_SECONDS=600
# 1 registers the ui://housewarden/pending MCP App resource (hosts that ignore it are unaffected).
HOUSEWARDEN_MCP_APP=0

# --- Presentation --------------------------------------------------------------
# Public URL shown on /settings as the MCP endpoint (derived from the request when unset).
# HOUSEWARDEN_PUBLIC_URL=https://housewarden.example.com
# 1 sets the Secure flag on the console cookie (turn on behind HTTPS).
HOUSEWARDEN_COOKIE_SECURE=0
# Used when the demo household is created.
HOUSEWARDEN_TIMEZONE=Asia/Karachi
HOUSEWARDEN_CURRENCY=PKR

# --- Next.js -------------------------------------------------------------------
PORT=3000
